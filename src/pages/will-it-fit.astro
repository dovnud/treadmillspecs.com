---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { models } from '../data/models';
import { SITE } from '../lib/site';
import { crumbLd, webPageLd } from '../lib/ld';

const crumbs = [{ name: 'Will it fit', path: '/will-it-fit/' }];
const desc = 'Check a treadmill’s published footprint, manufacturer clearances, and ceiling rule against your room. Missing clearances are not invented.';
const faqs = [
  {
    q: 'Where do the clearance inches come from?',
    a: 'Only from the manufacturer page or owner’s manual cited on the model. Sole’s 2026 F63, F65, F80, and F85 manuals say 3 1/2 feet behind the treadmill. BowFlex prints user height plus 20.75 inches for ceiling height. Peloton prints its own side, rear, and ceiling figures. Other models are checked on footprint and machine height alone when clearance is unpublished.',
  },
  {
    q: 'Do you add incline rise?',
    a: 'Only when the manufacturer publishes a ceiling rule that already accounts for the person on the machine. This site does not estimate rise from incline percent and deck length.',
  },
  {
    q: 'What standards are not used as numbers?',
    a: 'ASTM F2115 is the motorized-treadmill specification, and it is paywalled. This calculator does not quote clearance inches from it. If a manual cites a clearance, that manual is the source.',
  },
];
const jsonld = [
  webPageLd('Will a treadmill fit', '/will-it-fit/', desc, SITE.checked),
  crumbLd(crumbs),
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title="Will a treadmill fit your room" description={desc} path="/will-it-fit/" nav="fit" og="/og/page-will-it-fit.png" jsonld={jsonld}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>Will it fit</h1>
      <p class="lede">Room length, room width, ceiling height, and user height, then a model. Results use published inches. Every line says what was added and what was left out.</p>
    </div>
    <form class="finder" id="fit-form">
      <div class="finder-head">Room check <span>Inches, except weight</span></div>
      <div class="finder-body">
        <div class="f-grid">
          <div><label for="roomL">Room length (in)</label><input id="roomL" name="roomL" type="number" min="1" step="0.1" required value="120" /></div>
          <div><label for="roomW">Room width (in)</label><input id="roomW" name="roomW" type="number" min="1" step="0.1" required value="96" /></div>
          <div><label for="ceiling">Ceiling height (in)</label><input id="ceiling" name="ceiling" type="number" min="1" step="0.1" required value="96" /></div>
          <div><label for="userH">User height (in)</label><input id="userH" name="userH" type="number" min="1" step="0.1" required value="70" /></div>
          <div><label for="userW">User weight, lb (optional)</label><input id="userW" name="userW" type="number" min="1" step="1" /></div>
          <div>
            <label for="mode">Check</label>
            <select id="mode" name="mode">
              <option value="use">Unfolded, in use</option>
              <option value="stored">Folded, stored</option>
            </select>
          </div>
        </div>
        <label for="model" style="margin-top:12px">Model</label>
        <select id="model" name="model" required>
          {models.map((m) => <option value={m.slug}>{m.name}</option>)}
        </select>
        <button class="f-btn" type="submit">Check the published inches</button>
      </div>
    </form>
    <div id="fit-out" hidden></div>
    <h2>How a pass is decided</h2>
    <div class="prose">
      <ul>
        <li>The floor rectangle is the published machine length and width. Published front, rear, and side clearances are added on the “in use” check. If a side or end is not published, it is not filled in.</li>
        <li>That rectangle may sit either way in the room. Clearances stay on the machine’s length and width. They are not swapped.</li>
        <li>Stored mode uses folded dimensions only, and only when the manufacturer published them. Workout clearances are not applied to a folded machine.</li>
        <li>Ceiling: the machine height must be under the ceiling. If the maker publishes “user height plus N inches” or a minimum ceiling, those rules are applied as written. Otherwise, when step-up height is published, the check is step-up plus user height, with no incline rise and no extra headroom.</li>
        <li>A second rear figure on the same Peloton page is kept, and the larger one is the one that must fit.</li>
      </ul>
    </div>
    <div class="prose">
      <h2>Three published examples</h2>
      <p>Sole F63, in use: the machine is 75 by 34 by 52 inches, and the 2026 manual adds 42 inches behind it. Side and front clearances are not in that section, so they are not added. A room that is exactly 75 inches long fails. A room that is 120 inches on the long wall can pass the floor line if the width also clears 34 inches. Step-up height is not published, so the person-on-the-deck sum is skipped. There is no ceiling rule to apply beyond the 52 inch machine height.</p>
      <p>BowFlex T6: the open machine is 76 by 35 by 71, and folding does not lower that 71 inch height. The ceiling rule is user height plus 20.75 inches. A 70 inch user needs 90.75 inches of ceiling. The machine-height line can pass in a 96 inch room while the ceiling rule still fails. Floor clearance is not printed.</p>
      <p>Peloton Tread Vision: the chassis is 68 by 33 by 65, which looks small on the footprint list. Delivery text and the FAQ add 24 inches in front, 24 inches on each side, and 79 inches behind (the larger of 78.7 and 79). The in-use rectangle is 171 by 81 inches. The ceiling must clear both 84 inches and user height plus 20 inches. A 170 inch room fails the floor line even though the chassis itself would fit.</p>
      <p>Stored mode is a different question. It uses folded dimensions only, and only when they were published. Workout clearances are not applied to a folded machine. The T Series 6.5 S URL and the Sole TT8 do not publish a folded size, so stored mode cannot check them.</p>
    </div>
    <h2>Common questions</h2>
    {faqs.map((f) => (
      <h3>{f.q}</h3>
      <p>{f.a}</p>
    ))}
  </div>
</Base>
<script>
  import { getModel, modelPath } from '../data/models';
  import { evaluateFit } from '../lib/fit';

  const form = document.getElementById('fit-form') as HTMLFormElement;
  const out = document.getElementById('fit-out') as HTMLElement;
  const params = new URLSearchParams(location.search);
  const preset = params.get('model');
  if (preset) {
    const select = form.querySelector('#model') as HTMLSelectElement;
    if ([...select.options].some((o) => o.value === preset)) select.value = preset;
  }
  for (const id of ['roomL', 'roomW', 'ceiling', 'userH', 'userW']) {
    const value = params.get(id);
    const field = form.querySelector(`#${id}`) as HTMLInputElement | null;
    if (value && field) field.value = value;
  }
  const mode = params.get('mode');
  if (mode === 'use' || mode === 'stored') {
    const modeField = form.querySelector('#mode') as HTMLSelectElement;
    modeField.value = mode;
  }
  const ready = ['roomL', 'roomW', 'ceiling', 'userH', 'model'].every((id) => params.get(id));
  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const data = new FormData(form);
    const model = getModel(String(data.get('model')));
    if (!model) return;
    const userW = String(data.get('userW') || '');
    const result = evaluateFit(model, {
      roomL: Number(data.get('roomL')),
      roomW: Number(data.get('roomW')),
      ceiling: Number(data.get('ceiling')),
      userH: Number(data.get('userH')),
      userW: userW ? Number(userW) : undefined,
      mode: String(data.get('mode')) === 'stored' ? 'stored' : 'use',
    });
    const labels = { pass: 'Pass', fail: 'Fail', warn: 'Note', na: 'Not published' };
    const rows = result.checks.map((ch) => `<div class="check-row"><div class="pill ${ch.status}">${labels[ch.status]}</div><div><strong>${ch.title}</strong><p>${ch.detail}</p></div></div>`).join('');
    out.hidden = false;
    out.innerHTML = `<h2>${result.headline}</h2><p><a href="${modelPath(model)}">${model.name} spec table</a></p>${rows}`;
    out.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  if (ready) form.requestSubmit();
</script>
