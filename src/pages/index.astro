---
import Base from '../layouts/Base.astro';
import HeroArt from '../components/HeroArt.astro';
import { models, modelPath, brands, useBox, floorArea } from '../data/models';
import { linkFor, AFFILIATE_REL, AFFILIATE_TARGET } from '../config/affiliate';
import { comparisonCopy } from '../data/comparison-copy';
import { SITE } from '../lib/site';
import { crumbLd, webPageLd } from '../lib/ld';

const desc = 'Treadmill deck, motor, and footprint from manufacturer pages, with Amazon links and lists for small rooms, low ceilings, and folding models.';
const featured = [
  'nordictrack-commercial-1750-vs-nordictrack-commercial-2450',
  'sole-f80-vs-sole-f85',
  'peloton-tread-vision-vs-peloton-tread-plus-vision',
].map((slug) => comparisonCopy.find((item) => item.slug === slug)!);
const ranked = models
  .map((m) => ({ m, area: floorArea(m), box: useBox(m) }))
  .filter((row) => row.area != null && row.box)
  .sort((a, b) => a.area! - b.area!);
const jsonld = [
  webPageLd('Treadmill specs and room fit', '/', desc, SITE.checked),
  crumbLd([]),
  {
    '@type': 'ItemList',
    name: 'Treadmill buying lists from published specs',
    itemListElement: [
      { name: 'Best for small spaces', path: '/compare/best-for-small-spaces/' },
      { name: 'Best for low ceilings', path: '/compare/best-for-low-ceilings/' },
      { name: 'Smallest folding footprints', path: '/compare/smallest-folding-footprints/' },
      { name: 'Will it fit', path: '/will-it-fit/' },
    ].map((item, i) => ({ '@type': 'ListItem', position: i + 1, name: item.name, url: SITE.url + item.path })),
  },
];
const brandList = brands();
const shop = models.slice(0, 6);
---
<Base title="Treadmill specs and room fit" description={desc} path="/" nav="home" og="/og/default.png" jsonld={jsonld}>
  <div class="wrap hero">
    <div class="hero-grid">
      <div>
        <h1>Treadmill specs and room fit</h1>
        <p class="lede">Deck, motor, user weight, and footprint taken from the manufacturer page for each model. The lists below sort those inches. Amazon links sit on the model pages. Prices are not shown.</p>
        <div class="hero-ctas">
          <a class="btn" href="/compare/best-for-small-spaces/">Small rooms</a>
          <a class="btn" href="/compare/smallest-folding-footprints/">Folding floor</a>
          <a class="btn ghost" href="/will-it-fit/">Will it fit</a>
        </div>
      </div>
      <HeroArt />
    </div>
  </div>
  <section class="wrap" id="room-check">
    <form class="finder" action="/will-it-fit/" method="get">
      <div class="finder-head">Will it fit <span>Your room, then a model</span></div>
      <div class="finder-body">
        <div class="f-grid">
          <div><label for="home-roomL">Room length (in)</label><input id="home-roomL" name="roomL" type="number" min="1" step="0.1" required inputmode="decimal" /></div>
          <div><label for="home-roomW">Room width (in)</label><input id="home-roomW" name="roomW" type="number" min="1" step="0.1" required inputmode="decimal" /></div>
          <div><label for="home-ceiling">Ceiling height (in)</label><input id="home-ceiling" name="ceiling" type="number" min="1" step="0.1" required inputmode="decimal" /></div>
          <div><label for="home-userH">User height (in)</label><input id="home-userH" name="userH" type="number" min="1" step="0.1" required inputmode="decimal" /></div>
        </div>
        <label for="home-model" style="margin-top:12px">Model</label>
        <select id="home-model" name="model" required>
          {models.map((m) => <option value={m.slug}>{m.name}</option>)}
        </select>
        <input type="hidden" name="mode" value="use" />
        <button class="f-btn" type="submit">Check this room</button>
      </div>
    </form>
    <div class="grid3">
      <a class="card" href="/compare/best-for-small-spaces/">
        <h3>Small rooms</h3>
        <p>Unfolded length times width, shortest footprint first. Clearance the maker asks you to leave around the machine is not folded into the rank. That clearance is on the model page when it exists.</p>
      </a>
      <a class="card" href="/compare/best-for-low-ceilings/">
        <h3>Low ceilings</h3>
        <p>Shortest published machine height first, plus the ceiling rules a few makers print. A short chassis is not the same thing as enough room for the person on the belt.</p>
      </a>
      <a class="card" href="/compare/smallest-folding-footprints/">
        <h3>Smallest folding footprints</h3>
        <p>Only models the manufacturer says fold, ranked by published floor area. The X16 and X24 pages say they do not fold. Unpublished fold status stays off the list.</p>
      </a>
    </div>
    <h2>Comparisons with a verdict</h2>
    <p>Eighteen pairs have a written comparison. The source rules are on <a href="/how-we-verify/">how we verify</a>.</p>
    <div class="grid3">
      {featured.map((item) => {
        const [a, b] = item.slug.split('-vs-');
        const left = models.find((m) => m.slug === a);
        const right = models.find((m) => m.slug === b);
        return (
          <a class="card" href={`/compare/${item.slug}/`}>
            <h3>{left?.name.replace(/^NordicTrack |^Sole |^Peloton /, '')} vs {right?.name.replace(/^NordicTrack |^Sole |^Peloton /, '')}</h3>
            <p>{item.summary}</p>
          </a>
        );
      })}
    </div>
    <h2>Footprint, smallest floor first</h2>
    <p>Square inches are unfolded length times width. They do not include a safety border. {ranked[0] && <>The smallest floor in this set is the {ranked[0].m.name}, at {ranked[0].box!.l} by {ranked[0].box!.w} inches.</>}</p>
    <div class="tblwrap">
      <table>
        <thead><tr><th>Model</th><th>Floor</th><th>Area</th><th>Max user</th></tr></thead>
        <tbody>
          {ranked.map((row) => (
            <tr>
              <td><a href={modelPath(row.m)}>{row.m.name}</a></td>
              <td class="mono">{row.box!.l}" × {row.box!.w}"</td>
              <td class="mono">{Math.round(row.area!)} in²</td>
              <td>{row.m.maxUser.published ? row.m.maxUser.text : 'Not published'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <h2>Models with an Amazon link on the page</h2>
    <div class="grid3">
      {shop.map((m) => {
        const link = linkFor(m.slug, m.searchQuery);
        return (
          <article class="card">
            <h3><a href={modelPath(m)}>{m.name}</a></h3>
            <p class="small">{m.deck.published ? m.deck.text : 'Running surface not published.'}</p>
            <p><a href={link.href} rel={AFFILIATE_REL} target={AFFILIATE_TARGET}>{link.kind === 'product' ? 'View on Amazon' : 'Search Amazon'}</a></p>
          </article>
        );
      })}
    </div>
    <p><a href="/models/">All {models.length} models</a></p>
    <h2>Brands</h2>
    <div class="grid3">
      {brandList.map((b) => (
        <a class="card" href={`/brands/${b.slug}/`}>
          <h3>{b.name}</h3>
          <p>{b.count} model{b.count === 1 ? '' : 's'} with a spec table and a buying note.</p>
        </a>
      ))}
    </div>
  </section>
</Base>
