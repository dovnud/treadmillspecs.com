---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Sections from '../../components/Sections.astro';
import { brands, models, modelPath, useBox } from '../../data/models';
import { brandSections } from '../../lib/narrative';
import { SITE } from '../../lib/site';
import { crumbLd, webPageLd } from '../../lib/ld';

export function getStaticPaths() {
  return brands().map((b) => ({ params: { brand: b.slug }, props: { brand: b } }));
}
const { brand } = Astro.props;
const list = models.filter((m) => m.brandSlug === brand.slug);
const path = `/brands/${brand.slug}/`;
const crumbs = [{ name: brand.name, path }];
const sections = brandSections(brand.slug);
const desc = sections[0].paragraphs[0].slice(0, 220);
const jsonld = [
  webPageLd(`${brand.name} treadmill specs`, path, desc, SITE.checked),
  crumbLd(crumbs),
  { '@type': 'ItemList', itemListElement: list.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.name, url: SITE.url + modelPath(m) })) },
];
---
<Base title={`${brand.name} treadmill specs`} description={desc} path={path} nav="models" og={`/og/brand-${brand.slug}.png`} jsonld={jsonld}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>{brand.name} treadmill specs</h1>
      <p class="lede">{list.length} model{list.length === 1 ? '' : 's'} with a cited table. The notes below say how those published rows differ. The model page is the full citation.</p>
    </div>
    <Sections sections={sections} />
    <h2>Spec snapshot</h2>
    <div class="tblwrap">
      <table>
        <thead>
          <tr><th>Model</th><th>Running surface</th><th>Motor</th><th>User limit</th><th>Footprint</th><th>Folds</th></tr>
        </thead>
        <tbody>
          {list.map((m) => {
            const box = useBox(m);
            return (
              <tr>
                <td><a href={modelPath(m)}>{m.name}</a></td>
                <td>{m.deck.published ? m.deck.text : 'Not published by manufacturer'}</td>
                <td class={m.motor.published ? undefined : 'unpub'}>{m.motor.text}</td>
                <td>{m.maxUser.published ? m.maxUser.text : 'Not published by manufacturer'}</td>
                <td class="mono">{box ? `${box.l}" × ${box.w}" × ${box.h}"` : 'Not published'}</td>
                <td>{m.folds === 'yes' ? 'Yes' : m.folds === 'no' ? 'No' : 'Not published'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
</Base>
