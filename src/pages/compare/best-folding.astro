---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Sections from '../../components/Sections.astro';
import { modelPath } from '../../data/models';
import { foldingRanked, foldingSections } from '../../lib/narrative';
import { linkFor, AFFILIATE_REL, AFFILIATE_TARGET } from '../../config/affiliate';
import { SITE } from '../../lib/site';
import { crumbLd, webPageLd } from '../../lib/ld';

const ranked = foldingRanked();
const sections = foldingSections();
const path = '/compare/best-folding/';
const crumbs = [{ name: 'Compare', path: '/compare/' }, { name: 'Folding', path }];
const desc = 'Folding treadmills ranked by published unfolded floor area. Only models the manufacturer says fold. Stored height is in the table.';
const jsonld = [
  webPageLd('Folding treadmills by published footprint', path, desc, SITE.checked),
  crumbLd(crumbs),
  { '@type': 'ItemList', itemListElement: ranked.map((row, i) => ({ '@type': 'ListItem', position: i + 1, name: row.m.name, url: SITE.url + modelPath(row.m) })) },
];
---
<Base title="Folding treadmills by footprint" description={desc} path={path} nav="folding" og="/og/page-best-folding.png" jsonld={jsonld}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>Folding treadmills by footprint</h1>
      <p class="lede">Sorted by the smallest published unfolded floor area among machines the manufacturer says fold. It is not a cushion score, a motor test, or a price ranking. This site does not print prices, and there is no dated manufacturer price table behind a cutoff.</p>
    </div>
    <Sections sections={sections} />
    <div class="tblwrap">
      <table>
        <thead>
          <tr><th>#</th><th>Model</th><th>Unfolded L × W</th><th>Folded</th><th>Amazon</th></tr>
        </thead>
        <tbody>
          {ranked.map((row, i) => {
            const link = linkFor(row.m.slug, row.m.searchQuery);
            return (
              <tr>
                <td>{i + 1}</td>
                <td><a href={modelPath(row.m)}>{row.m.name}</a></td>
                <td class="mono">{row.box.l}" × {row.box.w}" · {Math.round(row.area)} in²</td>
                <td class="mono">{row.stored ? `${row.stored.l}" × ${row.stored.w}" × ${row.stored.h}"` : row.m.folded.text}</td>
                <td><a href={link.href} rel={AFFILIATE_REL} target={AFFILIATE_TARGET}>{link.kind === 'product' ? 'View' : 'Search'}</a></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="small muted">Models whose fold status is unpublished, including the T Series 6.5 S URL and the Sole TT8, are left off this list. The X16 and X24 pages say they do not fold.</p>
    <p><a href="/compare/best-for-small-spaces/">All footprints, including non-folding</a> · <a href="/will-it-fit/">Check a room</a></p>
  </div>
</Base>
