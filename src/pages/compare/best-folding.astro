---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Crumbs from '../../components/Crumbs.astro';
import { models, modelPath, useBox, storedBox } from '../../data/models';
import { linkFor, AFFILIATE_REL, AFFILIATE_TARGET } from '../../config/affiliate';
import { SITE } from '../../lib/site';
import { crumbLd, webPageLd } from '../../lib/ld';

const ranked = models
  .filter((m) => m.folds === 'yes')
  .map((m) => ({ m, box: useBox(m), stored: storedBox(m) }))
  .filter((row): row is { m: typeof models[number]; box: { l: number; w: number; h: number }; stored: { l: number; w: number; h: number } | null } => row.box != null)
  .map((row) => ({ ...row, area: row.box.l * row.box.w }))
  .sort((a, b) => a.area - b.area);
const path = '/compare/best-folding/';
const crumbs = [{ name: 'Compare', path: '/compare/' }, { name: 'Folding', path }];
const desc = 'Folding treadmills ranked by published unfolded floor area. Only models the manufacturer says fold. Not a ride-quality ranking.';
const jsonld = [
  webPageLd('Best folding treadmills by published footprint', path, desc, SITE.checked),
  crumbLd(crumbs),
  { '@type': 'ItemList', itemListElement: ranked.map((row, i) => ({ '@type': 'ListItem', position: i + 1, name: row.m.name, url: SITE.url + modelPath(row.m) })) },
];
---
<Base title="Best folding treadmills by footprint" description={desc} path={path} nav="folding" og="/og/page-best-folding.png" jsonld={jsonld}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>Best folding treadmills</h1>
      <p class="lede">“Best” on this page means the smallest published unfolded floor area among machines the manufacturer says fold. It is not a cushion score, a motor test, or a price ranking. We do not publish an “under $X” list: this site does not print prices, and there is no dated manufacturer price table behind a cutoff.</p>
      <Byline />
    </div>
    <div class="tblwrap">
      <table>
        <thead>
          <tr><th>#</th><th>Model</th><th>Unfolded L × W</th><th>Folded</th><th>Amazon</th></tr>
        </thead>
        <tbody>
          {ranked.map((row, i) => {
            const link = linkFor(row.m.slug, row.m.searchQuery);
            return (
              <tr>
                <td>{i + 1}</td>
                <td><a href={modelPath(row.m)}>{row.m.name}</a></td>
                <td class="mono">{row.box.l}" × {row.box.w}" · {Math.round(row.area)} in²</td>
                <td class="mono">{row.stored ? `${row.stored.l}" × ${row.stored.w}" × ${row.stored.h}"` : row.m.folded.text}</td>
                <td><a href={link.href} rel={AFFILIATE_REL} target={AFFILIATE_TARGET}>{link.kind === 'product' ? 'View' : 'Search'}</a></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="small muted">Models whose fold status is unpublished, including the T Series 6.5 S URL and the Sole TT8, are left off this list. The X16 and X24 pages say they do not fold.</p>
    <p><a href="/compare/best-for-small-spaces/">All footprints, including non-folding</a> · <a href="/will-it-fit/">Check a room</a></p>
  </div>
</Base>
