---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Sections from '../../components/Sections.astro';
import { pairs, modelPath } from '../../data/models';
import { specRows } from '../../lib/modelView';
import { isIndexedPair, pairBlurb, pairSections, relatedComparisons } from '../../lib/narrative';
import { SITE } from '../../lib/site';
import { crumbLd, webPageLd } from '../../lib/ld';

export function getStaticPaths() {
  return pairs().map((p) => ({ params: { pair: p.slug }, props: { pair: p } }));
}
const { pair } = Astro.props;
const path = `/compare/${pair.slug}/`;
const indexed = isIndexedPair(pair.slug);
const sections = indexed ? pairSections(pair.slug) : null;
const crumbs = [{ name: 'Compare', path: '/compare/' }, { name: `${pair.a.name} vs ${pair.b.name}`, path }];
const desc = indexed
  ? pairBlurb(pair.slug)
  : `${pair.a.name} and ${pair.b.name} side by side, each cell from that model’s manufacturer page.`;
const rowsA = specRows(pair.a);
const rowsB = specRows(pair.b);
const more = [
  ...relatedComparisons(pair.a.slug),
  ...relatedComparisons(pair.b.slug),
].filter((item, index, all) => item.slug !== pair.slug && all.findIndex((other) => other.slug === item.slug) === index);
const jsonld = [
  webPageLd(`${pair.a.name} vs ${pair.b.name}`, path, desc, SITE.checked),
  crumbLd(crumbs),
  {
    '@type': 'ItemList',
    itemListElement: [pair.a, pair.b].map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.name, url: SITE.url + modelPath(m) })),
  },
];
---
<Base title={`${pair.a.name} vs ${pair.b.name}`} description={desc} path={path} nav="compare" og="/og/page-compare.png" jsonld={jsonld} noindex={!indexed}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>{pair.a.name} vs {pair.b.name}</h1>
      {indexed ? (
        <p class="lede">The verdict uses only rows the manufacturer printed. A blank in the source stays “Not published by manufacturer.”</p>
      ) : (
        <p class="lede">This pair is not in the site index. The table is still the published rows. Written verdicts are limited to comparisons where those rows support a choice.</p>
      )}
    </div>
    {sections && <Sections sections={sections} />}
    <h2>Published rows</h2>
    <div class="tblwrap">
      <table>
        <thead>
          <tr>
            <th>Spec</th>
            <th><a href={modelPath(pair.a)}>{pair.a.name}</a></th>
            <th><a href={modelPath(pair.b)}>{pair.b.name}</a></th>
          </tr>
        </thead>
        <tbody>
          {rowsA.map((row, i) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td class={row.field.published ? undefined : 'unpub'}>
                {row.field.text}
                <div class="small"><a href={row.field.cite.url} rel="noopener">Source</a></div>
              </td>
              <td class={rowsB[i].field.published ? undefined : 'unpub'}>
                {rowsB[i].field.text}
                <div class="small"><a href={rowsB[i].field.cite.url} rel="noopener">Source</a></div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p><a href={`/will-it-fit/?model=${pair.a.slug}`}>Fit check, {pair.a.name}</a> · <a href={`/will-it-fit/?model=${pair.b.slug}`}>Fit check, {pair.b.name}</a></p>
    {more.length > 0 && (
      <>
        <h2>Other written comparisons</h2>
        <ul>
          {more.map((item) => <li><a href={`/compare/${item.slug}/`}>{item.label}</a></li>)}
        </ul>
      </>
    )}
  </div>
</Base>
