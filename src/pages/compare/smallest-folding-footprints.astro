---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { models, modelPath, useBox, storedBox } from '../../data/models';
import { linkFor, AFFILIATE_REL, AFFILIATE_TARGET } from '../../config/affiliate';
import { SITE } from '../../lib/site';
import { crumbLd, webPageLd } from '../../lib/ld';

const ranked = models
  .filter((m) => m.folds === 'yes')
  .map((m) => ({ m, box: useBox(m), stored: storedBox(m) }))
  .filter((row): row is { m: typeof models[number]; box: { l: number; w: number; h: number }; stored: { l: number; w: number; h: number } | null } => row.box != null)
  .map((row) => ({ ...row, area: row.box.l * row.box.w }))
  .sort((a, b) => a.area - b.area);
const path = '/compare/smallest-folding-footprints/';
const crumbs = [{ name: 'Compare', path: '/compare/' }, { name: 'Folding floor', path }];
const desc = 'Folding treadmills ranked by published unfolded floor area, smallest first. Only models the manufacturer says fold. Not a ride-quality ranking.';
const jsonld = [
  webPageLd('Smallest folding treadmill footprints', path, desc, SITE.checked),
  crumbLd(crumbs),
  { '@type': 'ItemList', itemListElement: ranked.map((row, i) => ({ '@type': 'ListItem', position: i + 1, name: row.m.name, url: SITE.url + modelPath(row.m) })) },
];
---
<Base title="Smallest folding treadmill footprints" description={desc} path={path} nav="folding" og="/og/page-best-folding.png" jsonld={jsonld}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>Smallest folding footprints</h1>
      <p class="lede">This list ranks machines the manufacturer says fold, by published unfolded floor area, smallest first. It is not a cushion score, a motor test, or a price ranking. This site does not print prices, and it does not publish a price cutoff.</p>
    </div>
    <div class="tblwrap">
      <table>
        <thead>
          <tr><th>#</th><th>Model</th><th>Unfolded L × W</th><th>Folded</th><th>Amazon</th></tr>
        </thead>
        <tbody>
          {ranked.map((row, i) => {
            const link = linkFor(row.m.slug, row.m.searchQuery);
            return (
              <tr>
                <td>{i + 1}</td>
                <td><a href={modelPath(row.m)}>{row.m.name}</a></td>
                <td class="mono">{row.box.l}" × {row.box.w}" · {Math.round(row.area)} in²</td>
                <td class="mono">{row.stored ? `${row.stored.l}" × ${row.stored.w}" × ${row.stored.h}"` : row.m.folded.text}</td>
                <td><a href={link.href} rel={AFFILIATE_REL} target={AFFILIATE_TARGET}>{link.kind === 'product' ? 'View' : 'Search'}</a></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <div class="prose">
      <h2>What “folds” required</h2>
      <p>A model is on this list only when its own page says it folds and prints a folded size the rank can show. The NordicTrack X16 and X24 spec strips say Foldable: No, so they are off the list even though their floor is shorter than some folders. The T Series 6.5 S URL does not print folded dimensions, even though the T Series 10 page for the same SKU does. The Sole TT8 full specifications do not list a folded size. The Life Fitness Run CX table does not either. A review on that shop page is not used as a folding row.</p>
      <p>Folding usually shortens the length and raises the height. Horizon’s 7.0 AT barely changes height (67 inches open, 68 folded) while cutting length from 76 to 44. Sole’s F63 goes from 52 inches open to 71 inches folded. Measure the closet against the folded height, not against the open height that won the rank. The smallest open floor here is the {ranked[0]?.m.name}, at {ranked[0] ? `${ranked[0].box.l} by ${ranked[0].box.w} inches` : 'the top of the table'}. Rear clearance from a manual is still extra floor while the machine is in use, and it is not inside this area.</p>
    </div>
    <p><a href="/compare/best-for-small-spaces/">All footprints, including non-folding</a> · <a href="/will-it-fit/">Check a room</a></p>
  </div>
</Base>
