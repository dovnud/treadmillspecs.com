---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { models, modelPath, useBox } from '../../data/models';
import { SITE } from '../../lib/site';
import { crumbLd, webPageLd } from '../../lib/ld';

const ranked = models
  .map((m) => ({ m, box: useBox(m) }))
  .filter((row): row is { m: typeof models[number]; box: { l: number; w: number; h: number } } => row.box != null)
  .sort((a, b) => a.box.h - b.box.h);
const withRule = models.filter((m) => m.clearance && (m.clearance.userPlusIn != null || m.clearance.minCeilingIn != null));
const path = '/compare/best-for-low-ceilings/';
const crumbs = [{ name: 'Compare', path: '/compare/' }, { name: 'Low ceilings', path }];
const desc = 'Treadmills ranked by published unfolded height, plus the ceiling rules manufacturers print.';
const jsonld = [
  webPageLd('Treadmills with the lowest published machine height', path, desc, SITE.checked),
  crumbLd(crumbs),
  { '@type': 'ItemList', itemListElement: ranked.map((row, i) => ({ '@type': 'ListItem', position: i + 1, name: row.m.name, url: SITE.url + modelPath(row.m) })) },
];
---
<Base title="Lowest published treadmill heights" description={desc} path={path} nav="ceilings" og="/og/page-low-ceilings.png" jsonld={jsonld}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>Lowest published machine heights</h1>
      <p class="lede">Sorted by unfolded height. A short machine is not the same thing as a low ceiling while someone is standing on the deck. Use the ceiling rules below, and the will-it-fit check, for that.</p>
    </div>
    <div class="tblwrap">
      <table>
        <thead><tr><th>#</th><th>Model</th><th>Unfolded height</th><th>Step-up</th></tr></thead>
        <tbody>
          {ranked.map((row, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><a href={modelPath(row.m)}>{row.m.name}</a></td>
              <td class="mono">{row.box.h}"</td>
              <td>{row.m.stepUp.published ? row.m.stepUp.text : 'Not published by manufacturer'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="prose">
      <h2>Machine height is only the first cut</h2>
      <p>The shortest open machine in this set is the {ranked[0]?.m.name} at {ranked[0]?.box.h} inches. That number is the treadmill, not the person. Where step-up height is published and the maker did not print a ceiling rule, the fit check adds step-up to the user height you enter and does not add incline rise. Where step-up is missing, that sum is skipped rather than filled from deck thickness.</p>
      <p>BowFlex prints one ceiling rule on the T6, T9, and T16: user height plus 20.75 inches. A 70 inch user needs 90.75 inches of ceiling under that sentence, which is well above the machine heights on those pages. Peloton prints a 7-foot minimum and a second rule tied to user height (plus 20 inches on the Tread Vision, plus 24 inches on the Tread+ Vision). Sole’s 2026 folding manuals state rear floor clearance and do not state a ceiling height. NordicTrack’s pages in this set do not state one either. A low rank here means a short chassis. It does not mean the ceiling rule, when one exists, will pass.</p>
    </div>
    <h2>Ceiling rules the manufacturer printed</h2>
    <p>These are not calculated from incline percent. If a model is missing, its page did not print a ceiling rule.</p>
    <div class="grid2">
      {withRule.map((m) => (
        <article class="card">
          <h3><a href={modelPath(m)}>{m.name}</a></h3>
          <p>{m.clearance?.summary}</p>
          <p class="small"><a href={m.clearance?.cite.url} rel="noopener">{m.clearance?.cite.where}</a></p>
        </article>
      ))}
    </div>
  </div>
</Base>
