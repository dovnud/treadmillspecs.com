---
import Base from '../layouts/Base.astro';
import Byline from '../components/Byline.astro';
import Crumbs from '../components/Crumbs.astro';
import { AMAZON_DISCLOSURE, AMAZON_TAG } from '../config/affiliate';
import { SITE } from '../lib/site';
import { crumbLd, webPageLd } from '../lib/ld';

const crumbs = [{ name: 'Affiliate disclosure', path: '/affiliate-disclosure/' }];
const desc = 'Amazon Associates disclosure for TreadmillSpecs.com. Links use tag treadmillspecs-20. Direct product links are only for ASINs checked on a live Amazon page. No prices are shown.';
const jsonld = [webPageLd('Affiliate disclosure', '/affiliate-disclosure/', desc, SITE.checked), crumbLd(crumbs)];
---
<Base title="Affiliate disclosure" description={desc} path="/affiliate-disclosure/" og="/og/page-affiliate-disclosure.png" jsonld={jsonld}>
  <div class="wrap prose">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>Affiliate disclosure</h1>
      <Byline />
    </div>
    <p>{AMAZON_DISCLOSURE}</p>
    <p>TreadmillSpecs.com participates in the Amazon Associates Program. Amazon is the only affiliate program on this site. Every Amazon link is built in one configuration file. The tag is <span class="mono">{AMAZON_TAG}</span>.</p>
    <p>A <span class="mono">/dp/</span> link is used only when we opened that Amazon product page on 1 November 2026 and the title named that one model. Seven models passed that check. The others use a tagged Amazon search, because the live results were a multi-model family, a different machine, or a title that did not name the model. A search is not a promise that the first result is the treadmill on the spec page.</p>
    <p>We do not show prices.</p>
    <p>Editorial rows are filled before a shopping link is added, and a missing spec is not filled in because a retailer page mentions one.</p>
  </div>
</Base>
