---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import SpecTable from '../../components/SpecTable.astro';
import BuyBlock from '../../components/BuyBlock.astro';
import FaqList from '../../components/FaqList.astro';
import ReminderForm from '../../components/ReminderForm.astro';
import Sections from '../../components/Sections.astro';
import { models, modelPath, useBox } from '../../data/models';
import { modelFaqs, productLd, specRows } from '../../lib/modelView';
import { modelSections, relatedComparisons } from '../../lib/narrative';
import { SITE } from '../../lib/site';
import { crumbLd, webPageLd } from '../../lib/ld';

export function getStaticPaths() {
  return models.map((m) => ({ params: { slug: m.slug }, props: { model: m } }));
}
const { model: m } = Astro.props;
const path = modelPath(m);
const crumbs = [{ name: 'Models', path: '/models/' }, { name: m.name, path }];
const desc = m.summary;
const faqs = modelFaqs(m);
const box = useBox(m);
const sections = modelSections(m);
const related = relatedComparisons(m.slug);
const jsonld = [
  webPageLd(`${m.name} specs`, path, desc, SITE.checked),
  crumbLd(crumbs),
  productLd(m),
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const rows = specRows(m);
---
<Base title={`${m.name} specs`} description={desc} path={path} nav="models" og={`/og/model-${m.slug}.png`} ogAlt={`${m.name} specs`} jsonld={jsonld}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <p class="kicker">{m.brand}{m.sku ? ` · ${m.sku}` : ''}</p>
      <h1>{m.name}</h1>
      <p class="lede">{m.summary}</p>
      <BuyBlock slug={m.slug} query={m.searchQuery} name={m.name} />
    </div>
    <Sections sections={sections} />
    {box && (
      <p class="small muted">
        Fit-check footprint: {box.l}" long, {box.w}" wide, {box.h}" high
        {m.maxUserLb != null ? `, user limit ${m.maxUserLb} lb` : ''}.
      </p>
    )}
    {m.fitUnfolded && <div class="callout"><p>{m.fitUnfolded.why}</p></div>}
    <h2>Specifications</h2>
    <p class="small muted">Read 1 November 2026. Each row links the manufacturer page it came from. A missing field stays “Not published by manufacturer.” Figures are not filled from another model year or from a review.</p>
    <SpecTable rows={rows} />
    {m.clearance && (
      <div class="oknote">
        <p><strong>Clearance the manufacturer published.</strong> {m.clearance.summary}</p>
        <p class="small"><a href={m.clearance.cite.url} rel="noopener">{m.clearance.cite.where}</a></p>
      </div>
    )}
    {m.notes.length > 0 && (
      <>
        <h2>Notes from the source</h2>
        <ul>{m.notes.map((n) => <li>{n}</li>)}</ul>
      </>
    )}
    {related.length > 0 && (
      <>
        <h2>Written comparisons</h2>
        <ul>
          {related.map((item) => (
            <li><a href={`/compare/${item.slug}/`}>{item.label}</a></li>
          ))}
        </ul>
      </>
    )}
    <p>
      <a href={m.productUrl} rel="noopener">Manufacturer page</a>
      · <a href={`/will-it-fit/?model=${m.slug}`}>Check this model in a room</a>
      · <a href="/compare/best-for-small-spaces/">Small-room list</a>
      · <a href="/compare/best-for-low-ceilings/">Low-ceiling list</a>
      · <a href="/compare/best-folding/">Folding list</a>
      · <a href={`/brands/${m.brandSlug}/`}>{m.brand} models</a>
    </p>
    <h2>Answers from the table</h2>
    <FaqList items={faqs} />
    <ReminderForm modelName={m.name} modelSlug={m.slug} pagePath={path} />
  </div>
</Base>
