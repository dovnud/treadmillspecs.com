---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Crumbs from '../../components/Crumbs.astro';
import SpecTable from '../../components/SpecTable.astro';
import BuyBlock from '../../components/BuyBlock.astro';
import FaqList from '../../components/FaqList.astro';
import ReminderForm from '../../components/ReminderForm.astro';
import { models, modelPath, useBox } from '../../data/models';
import { modelFaqs, productLd, specRows } from '../../lib/modelView';
import { SITE } from '../../lib/site';
import { crumbLd, webPageLd } from '../../lib/ld';

export function getStaticPaths() {
  return models.map((m) => ({ params: { slug: m.slug }, props: { model: m } }));
}
const { model: m } = Astro.props;
const path = modelPath(m);
const crumbs = [{ name: 'Models', path: '/models/' }, { name: m.name, path }];
const desc = m.summary;
const faqs = modelFaqs(m);
const box = useBox(m);
const jsonld = [
  webPageLd(`${m.name} specs`, path, desc, SITE.checked),
  crumbLd(crumbs),
  productLd(m),
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const rows = specRows(m);
---
<Base title={`${m.name} specs`} description={desc} path={path} nav="models" og={`/og/model-${m.slug}.png`} ogAlt={`${m.name} specs`} jsonld={jsonld}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <p class="kicker">{m.brand}{m.sku ? ` · ${m.sku}` : ''}</p>
      <h1>{m.name}</h1>
      <p class="lede">{m.summary}</p>
      <Byline />
    </div>
    {box && (
      <div class="spec-strip" aria-label="Published footprint">
        <div class="spec-cell"><b>{box.l}"</b><span>Length</span></div>
        <div class="spec-cell"><b>{box.w}"</b><span>Width</span></div>
        <div class="spec-cell"><b>{box.h}"</b><span>Height</span></div>
        <div class="spec-cell"><b>{m.maxUserLb ?? '—'}</b><span>Max user lb</span></div>
      </div>
    )}
    {m.fitUnfolded && <div class="callout"><p>{m.fitUnfolded.why}</p></div>}
    <h2>Specifications</h2>
    <p class="small muted">Values are copied from the cited page. They are not estimated from another model year or from a review.</p>
    <SpecTable rows={rows} />
    {m.clearance && (
      <div class="oknote">
        <p><strong>Clearance the manufacturer published.</strong> {m.clearance.summary}</p>
        <p class="small"><a href={m.clearance.cite.url} rel="noopener">{m.clearance.cite.where}</a></p>
      </div>
    )}
    {m.notes.length > 0 && (
      <>
        <h2>Notes from the source</h2>
        <ul>{m.notes.map((n) => <li>{n}</li>)}</ul>
      </>
    )}
    <p><a href={m.productUrl} rel="noopener">Manufacturer page</a> · <a href={`/will-it-fit/?model=${m.slug}`}>Check this model in a room</a> · <a href={`/brands/${m.brandSlug}/`}>{m.brand} models</a></p>
    <BuyBlock query={m.searchQuery} name={m.name} />
    <h2>Questions the table can answer</h2>
    <FaqList items={faqs} />
    <ReminderForm modelName={m.name} modelSlug={m.slug} pagePath={path} />
  </div>
</Base>
