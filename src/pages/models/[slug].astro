---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import SpecTable from '../../components/SpecTable.astro';
import BuyBlock from '../../components/BuyBlock.astro';
import FaqList from '../../components/FaqList.astro';
import ReminderForm from '../../components/ReminderForm.astro';
import GuideSections from '../../components/GuideSections.astro';
import { models, modelPath, useBox } from '../../data/models';
import { guides } from '../../data/guides';
import { comparisonsForModel } from '../../data/comparison-copy';
import { modelFaqs, modelPageLd, specRows } from '../../lib/modelView';
import { SITE } from '../../lib/site';

export function getStaticPaths() {
  return models.map((m) => ({ params: { slug: m.slug }, props: { model: m } }));
}
const { model: m } = Astro.props;
const path = modelPath(m);
const crumbs = [{ name: 'Models', path: '/models/' }, { name: m.name, path }];
const guide = guides[m.slug];
const desc = m.summary;
const faqs = modelFaqs(m);
const box = useBox(m);
const related = comparisonsForModel(m.slug);
const jsonld = modelPageLd(m, SITE.checked);
const rows = specRows(m);
---
<Base title={`${m.name} specs`} description={desc} path={path} nav="models" og={`/og/model-${m.slug}.png`} ogAlt={`${m.name} specs`} jsonld={jsonld}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <p class="kicker">{m.brand}{m.sku ? ` · ${m.sku}` : ''}</p>
      <h1>{m.name}</h1>
      <p class="lede">{m.summary}</p>
      <BuyBlock slug={m.slug} query={m.searchQuery} name={m.name} />
    </div>
    {guide && <GuideSections fits={guide.fits} room={guide.room} motor={guide.motor} warranty={guide.warranty} verdict={guide.verdict} />}
    <h2>Specifications</h2>
    {box && <p>The fit check uses {box.l} by {box.w} by {box.h} inches for the open machine{m.fitUnfolded ? ', taking the larger published figure on each axis' : ''}.</p>}
    <SpecTable rows={rows} />
    {m.clearance && (
      <div class="oknote">
        <p><strong>Clearance the manufacturer published.</strong> {m.clearance.summary}</p>
        <p class="small"><a href={m.clearance.cite.url} rel="noopener">{m.clearance.cite.where}</a></p>
      </div>
    )}
    {m.notes.length > 0 && (
      <>
        <h2>Notes from the manufacturer page</h2>
        <ul>{m.notes.map((n) => <li>{n}</li>)}</ul>
      </>
    )}
    <p>
      <a href={m.productUrl} rel="noopener">Manufacturer page</a>
      · <a href={`/will-it-fit/?model=${m.slug}`}>Check this model in a room</a>
      · <a href="/compare/best-for-small-spaces/">Small-room list</a>
      · <a href="/compare/best-for-low-ceilings/">Low-ceiling list</a>
      · <a href="/compare/best-folding/">Folding list</a>
      · <a href={`/brands/${m.brandSlug}/`}>{m.brand} models</a>
    </p>
    {related.length > 0 && (
      <>
        <h2>Comparisons that use these rows</h2>
        <ul>
          {related.map((item) => {
            const [a, b] = item.slug.split('-vs-');
            const other = models.find((model) => model.slug === (a === m.slug ? b : a));
            return <li><a href={`/compare/${item.slug}/`}>{m.name} vs {other?.name}</a>. {item.summary}</li>;
          })}
        </ul>
      </>
    )}
    <h2>Questions the table can answer</h2>
    <FaqList items={faqs} />
    <ReminderForm modelName={m.name} modelSlug={m.slug} pagePath={path} />
  </div>
</Base>
