---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { models, modelPath, useBox } from '../../data/models';
import { SITE } from '../../lib/site';
import { crumbLd, webPageLd } from '../../lib/ld';

const crumbs = [{ name: 'Models', path: '/models/' }];
const desc = 'Treadmill spec pages for NordicTrack, Sole, Horizon, BowFlex, Peloton, Life Fitness, and LifeSpan. Every number cites the manufacturer page it came from.';
const jsonld = [webPageLd('Treadmill models', '/models/', desc, SITE.checked), crumbLd(crumbs)];
---
<Base title="Treadmill models and specs" description={desc} path="/models/" nav="models" og="/og/page-models.png" jsonld={jsonld}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>Models</h1>
      <p class="lede">Each page is one machine: the published limits, the room and ceiling math, the motor and deck lines, a warranty note, and a verdict that stays inside those rows.</p>
    </div>
    <div class="prose">
      <p>The set is {models.length} current product pages: NordicTrack’s Commercial, T Series, and X machines; Sole’s F63 through F85 plus the TT8; Horizon’s 7.0 AT, 7.4 AT, 7.8 AT, and T202; BowFlex’s T6, T9, and T16; Peloton’s Tread Vision and Tread+ Vision; the Life Fitness Run CX; and the LifeSpan TR1200i. A missing field stays “Not published by manufacturer.” Horsepower is blank on Horizon, BowFlex, and Peloton because those pages did not print it. NordicTrack’s CHP numbers stay, with the lab-rating footnote.</p>
      <p>Use a brand page for the line in one table. Use a maintained comparison when two models in the same line differ in a way the specs can settle. Use the room check when you have a length, a width, and a ceiling.</p>
    </div>
    <div class="grid2">
      {models.map((m) => {
        const box = useBox(m);
        return (
          <a class="card" href={modelPath(m)}>
            <p class="kicker">{m.brand}{m.sku ? ` · ${m.sku}` : ''}</p>
            <h2>{m.name}</h2>
            <p>{m.deck.published ? m.deck.text : 'Running surface not published.'}</p>
            <p class="small muted">{box ? `Footprint ${box.l}" × ${box.w}" × ${box.h}"` : 'Footprint not published.'} · {m.maxUser.text}</p>
            <p class="go">Spec table</p>
          </a>
        );
      })}
    </div>
  </div>
</Base>
