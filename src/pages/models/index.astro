---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { models, modelPath, useBox } from '../../data/models';
import { modelsIndexIntro } from '../../lib/narrative';
import { SITE } from '../../lib/site';
import { crumbLd, webPageLd } from '../../lib/ld';

const crumbs = [{ name: 'Models', path: '/models/' }];
const intro = modelsIndexIntro();
const desc = 'Treadmill spec pages for NordicTrack, Sole, Horizon, BowFlex, Peloton, Life Fitness, and LifeSpan. Every number cites the manufacturer page it came from.';
const jsonld = [webPageLd('Treadmill models', '/models/', desc, SITE.checked), crumbLd(crumbs)];
---
<Base title="Treadmill models and specs" description={desc} path="/models/" nav="models" og="/og/page-models.png" jsonld={jsonld}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>Treadmill models</h1>
      <p class="lede">Each page is one machine. The table is what the manufacturer published, with the URL it came from.</p>
    </div>
    <div class="prose">
      {intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="tblwrap">
      <table>
        <thead>
          <tr><th>Model</th><th>Running surface</th><th>Motor</th><th>Footprint</th><th>Folds</th></tr>
        </thead>
        <tbody>
          {models.map((m) => {
            const box = useBox(m);
            return (
              <tr>
                <td><a href={modelPath(m)}>{m.name}</a></td>
                <td>{m.deck.published ? m.deck.text : 'Not published by manufacturer'}</td>
                <td class={m.motor.published ? undefined : 'unpub'}>{m.motor.text}</td>
                <td class="mono">{box ? `${box.l}" × ${box.w}" × ${box.h}"` : 'Not published'}</td>
                <td>{m.folds === 'yes' ? 'Yes' : m.folds === 'no' ? 'No' : 'Not published'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
</Base>
