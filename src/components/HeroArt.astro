---
/** Original line drawing. Not a manufacturer photo. */
---
<figure class="hero-art" aria-hidden="true">
  <svg viewBox="0 0 420 280" role="img">
    <title>A treadmill inside a measured room</title>
    <rect class="room" x="28" y="36" width="300" height="200" rx="8" />
    <path class="dim" d="M36 28 H320" />
    <path class="dim" d="M340 44 V228" />
    <text class="dim-label" x="150" y="22">length</text>
    <text class="dim-label" x="348" y="140">width</text>
    <g class="mill" transform="translate(78 108)">
      <rect class="deck" x="0" y="46" width="196" height="28" rx="6" />
      <path class="belt" d="M14 60 H182" />
      <rect class="upright" x="156" y="8" width="8" height="46" rx="2" />
      <rect class="console" x="138" y="0" width="46" height="16" rx="3" />
      <circle class="wheel" cx="22" cy="78" r="7" />
      <circle class="wheel" cx="174" cy="78" r="7" />
    </g>
    <g class="clearance">
      <path d="M78 196 H274" />
      <text x="140" y="214">clearance only if published</text>
    </g>
  </svg>
</figure>
