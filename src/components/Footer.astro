---
import { SITE } from '../lib/site';
import { brands } from '../data/models';
const brandList = brands();
---
<footer class="site">
  <div class="foot-in wrap">
    <div>
      <p class="foot-brand">Treadmill<span>Specs</span></p>
      <p>Manufacturer pages only. If a treadmill spec is not printed by the maker, the cell says so. The will-it-fit check uses those published inches and states every assumption.</p>
      <p>Corrections: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <div class="lane-mark" aria-hidden="true"><i></i><i></i><i></i></div>
    </div>
    <div>
      <p class="foot-h">Brands</p>
      <ul>
        {brandList.map((b) => <li><a href={`/brands/${b.slug}/`}>{b.name}</a></li>)}
        <li><a href="/models/">All models</a></li>
        <li><a href="/will-it-fit/">Will it fit</a></li>
        <li><a href="/compare/best-for-small-spaces/">Small-space list</a></li>
        <li><a href="/compare/best-for-low-ceilings/">Low-ceiling list</a></li>
      </ul>
    </div>
    <div>
      <p class="foot-h">This site</p>
      <ul>
        <li><a href="/how-we-verify/">How we verify</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/llms.txt">llms.txt</a></li>
      </ul>
    </div>
  </div>
  <div class="disclaimer wrap">
    <p>TreadmillSpecs.com is independent. It is not affiliated with NordicTrack, Sole, Horizon, BowFlex, Peloton, Life Fitness, LifeSpan, or Amazon. Product names are trademarks of their owners and are used here to identify the machines.</p>
    <p>As an Amazon Associate I earn from qualifying purchases. The Associates tag is not in the links until it is set in the site configuration. No prices are shown. Specs were read from manufacturer pages on 1 November 2026.</p>
  </div>
</footer>
