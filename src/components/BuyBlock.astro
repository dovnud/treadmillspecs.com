---
import { AFFILIATE_REL, AFFILIATE_TARGET, AMAZON_DISCLOSURE, AMAZON_TAG, amazonSearchUrl } from '../config/affiliate';
interface Props { query: string; name: string }
const { query, name } = Astro.props;
const href = amazonSearchUrl(query);
---
<aside class="buy">
  <div class="buy-head">Find it on Amazon</div>
  <div class="buy-body">
    <p><a class="btn" href={href} rel={AFFILIATE_REL} target={AFFILIATE_TARGET}>Search Amazon for the {name}</a></p>
    <p class="amz-note">{AMAZON_DISCLOSURE} {AMAZON_TAG === 'TODO-TAG' ? 'The Associates tag is not active yet, so this search link has no tag parameter.' : ''} No price is shown here. Amazon search results change, and a result is not a verified product match.</p>
  </div>
</aside>
